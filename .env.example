# ── VURVE ENVIRONMENT CONFIGURATION ──

# App runtime settings
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database settings
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vurve

# JWT configuration
JWT_SECRET=super_secret_jwt_key_change_me

# Cloudflare R2 / S3 details
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=vurve-assets
R2_PUBLIC_CDN_URL=https://assets.vurve.dev

# Internal communications secret
INTERNAL_WORKER_SECRET=internal_secret_token_goes_here